# ============================================================
# TEXT BEREINIGEN
# ============================================================

def clean_text(text):

    replacements = {
        "\u00a0": " ",
        "\u2000": " ",
        "\u2001": " ",
        "\u2002": " ",
        "\u2003": " ",
        "\u2004": " ",
        "\u2005": " ",
        "\u2006": " ",
        "\u2007": " ",
        "\u2008": " ",
        "\u2009": " ",
        "\u200a": " ",
        "\u202f": " ",
        "\u205f": " ",
        "\u3000": " ",

        "\u200b": "",
        "\u200c": "",
        "\u200d": "",
        "\ufeff": "",
        "\u00ad": "",

        "\u2010": "-",
        "\u2011": "-",
        "\u2012": "-",
        "\u2013": "-",
        "\u2014": "-",
        "\u2212": "-",

        "\u2018": "'",
        "\u2019": "'",
        "\u201a": "'",
        "\u201b": "'",

        "\u201c": '"',
        "\u201d": '"',
        "\u201e": '"',
        "\u201f": '"',

        "\u2026": "...",

        "\u00ab": '"',
        "\u00bb": '"',
    }

    for old, new in replacements.items():
        text = text.replace(old, new)

    # Steuerzeichen entfernen
    text = "".join(
        c for c in text
        if c in "\n\t" or ord(c) >= 32
    )

    # Tabs
    text = text.replace("\t", " ")

    # Mehrfache Leerzeichen
    text = re.sub(
        r" {2,}",
        " ",
        text
    )

    return text


# ============================================================
# FLIESSTEXT AUF 78 ZEICHEN UMBRECHEN
# ============================================================

def wrap_text(text, width=TEXT_WIDTH):

    result = []

    for line in text.splitlines():

        line = line.strip()

        if not line:
            result.append("")
            continue

        # Tabellen und Rahmen niemals umbrechen
        if (
            line.startswith("+")
            or line.startswith("|")
        ):
            result.append(line)
            continue

        # Überschriften nicht umbrechen
        if line.startswith("="):
            result.append(line)
            continue

        # Listen
        if line.startswith("- "):

            wrapped = textwrap.wrap(
                line,
                width=width,
                subsequent_indent="  ",
                break_long_words=False,
                break_on_hyphens=False
            )

        else:

            wrapped = textwrap.wrap(
                line,
                width=width,
                break_long_words=False,
                break_on_hyphens=False
            )

        result.extend(wrapped)

    return "\n".join(result)


# ============================================================
# ASCII-TABELLEN
# ============================================================

def render_table(rows, caption=None, width=TEXT_WIDTH):

    if not rows:
        return []

    # Leere Zeilen entfernen
    rows = [
        row for row in rows
        if row.get("cells")
    ]

    if not rows:
        return []

    # Maximale Anzahl Spalten
    column_count = max(
        len(row["cells"])
        for row in rows
    )

    if column_count == 0:
        return []

    # Fehlende Zellen auffüllen
    for row in rows:

        while len(row["cells"]) < column_count:
            row["cells"].append("")

    # Jede Zelle säubern
    for row in rows:

        row["cells"] = [
            clean_text(cell).strip()
            for cell in row["cells"]
        ]

    # --------------------------------------------------------
    # Verfügbare Breite berechnen
    #
    # Format:
    #
    # | Inhalt | Inhalt |
    #
    # benötigt:
    # 3 Zeichen pro Trennstelle + 1 für die äußeren Grenzen
    # --------------------------------------------------------

    available = (
        width
        - (
            column_count * 3
            + 1
        )
    )

    # Mindestbreite pro Spalte
    minimum = 8

    if available < column_count * minimum:

        minimum = max(
            3,
            available // column_count
        )

    # --------------------------------------------------------
    # Natürliche Spaltenbreiten bestimmen
    # --------------------------------------------------------

    natural_widths = [
        0
        for _ in range(column_count)
    ]

    for row in rows:

        for index, cell in enumerate(
            row["cells"]
        ):

            longest = max(
                (
                    len(part)
                    for part in cell.splitlines()
                ),
                default=0
            )

            natural_widths[index] = max(
                natural_widths[index],
                longest
            )

    # Maximal sinnvolle Breite pro Spalte
    max_column_width = 32

    column_widths = [
        max(
            minimum,
            min(
                natural,
                max_column_width
            )
        )
        for natural in natural_widths
    ]

    # --------------------------------------------------------
    # Breiten reduzieren, falls Tabelle zu breit wird
    # --------------------------------------------------------

    total = sum(column_widths)

    while total > available:

        largest = max(
            range(column_count),
            key=lambda i: column_widths[i]
        )

        if column_widths[largest] <= minimum:
            break

        column_widths[largest] -= 1
        total -= 1

    # --------------------------------------------------------
    # Tabellenrahmen
    # --------------------------------------------------------

    separator = (
        "+"
        + "+".join(
            "-" * (column_widths[i] + 2)
            for i in range(column_count)
        )
        + "+"
    )

    output = []

    if caption:

        caption = clean_text(
            caption
        ).strip()

        if caption:

            output.append(
                ""
            )

            caption_lines = textwrap.wrap(
                caption,
                width=width,
                break_long_words=True,
                break_on_hyphens=False
            )

            output.extend(
                caption_lines
            )

    output.append(
        separator
    )

    # --------------------------------------------------------
    # Tabellenzeilen erzeugen
    # --------------------------------------------------------

    for row_index, row in enumerate(rows):

        wrapped_cells = []

        for index, cell in enumerate(
            row["cells"]
        ):

            cell = cell.strip()

            if not cell:
                cell = ""

            wrapped = textwrap.wrap(
                cell,
                width=column_widths[index],
                break_long_words=True,
                break_on_hyphens=False
            )

            if not wrapped:
                wrapped = [""]

            wrapped_cells.append(
                wrapped
            )

        row_height = max(
            len(cell)
            for cell in wrapped_cells
        )

        for line_index in range(row_height):

            parts = []

            for column_index in range(
                column_count
            ):

                cell_lines = wrapped_cells[
                    column_index
                ]

                if line_index < len(
                    cell_lines
                ):

                    value = cell_lines[
                        line_index
                    ]

                else:

                    value = ""

                value = value.ljust(
                    column_widths[
                        column_index
                    ]
                )

                parts.append(
                    value
                )

            output.append(
                "| "
                + " | ".join(parts)
                + " |"
            )

        # Trennlinie nach Tabellenkopf
        if row.get("header"):

            output.append(
                separator
            )

    # Untere Begrenzung
    if not output or output[-1] != separator:

        output.append(
            separator
        )

    output.append("")

    return output


# ============================================================
# HTML -> TEXT
# ============================================================

class WikipediaParser(HTMLParser):

    def __init__(self):

        super().__init__(
            convert_charrefs=True
        )

        self.lines = []
        self.current = ""

        # Wikipedia-Links
        self.links = []

        # Aktueller Link
        self.current_link = None

        # Ignorierter HTML-Bereich
        self.skip_depth = 0

        # ----------------------------------------------------
        # Tabellen
        # ----------------------------------------------------

        self.table_depth = 0
        self.table_rows = []
        self.table_current_row = None
        self.table_current_cell = None
        self.table_current_cell_is_header = False
        self.table_caption = None

        self.block_tags = {
            "p",
            "div",
            "section",
            "h1",
            "h2",
            "h3",
            "h4",
            "h5",
            "h6",
            "li",
            "dd",
            "dt",
            "blockquote",
            "pre"
        }

        self.skip_tags = {
            "script",
            "style",
            "noscript",
            "svg",
            "math"
        }

    # ========================================================
    # STARTTAG
    # ========================================================

    def handle_starttag(
        self,
        tag,
        attrs
    ):

        attrs = dict(attrs)

        # ----------------------------------------------------
        # Tabelle
        # ----------------------------------------------------

        if tag == "table" and not self.skip_depth:

            if self.table_depth == 0:

                self.finish_line()

                self.table_rows = []
                self.table_caption = None
                self.table_current_row = None
                self.table_current_cell = None

            self.table_depth += 1

            return

        # ----------------------------------------------------
        # Verschachtelte Tabelle
        # ----------------------------------------------------

        if self.table_depth > 1:

            if tag == "table":

                self.table_depth += 1

            return

        # ----------------------------------------------------
        # Innerhalb einer Tabelle
        # ----------------------------------------------------

        if self.table_depth == 1:

            if tag == "tr":

                self.finish_table_row()

                self.table_current_row = []
                self.table_current_cell = None
                self.table_current_cell_is_header = False

                return

            if tag in {"td", "th"}:

                self.finish_table_cell()

                self.table_current_cell = ""
                self.table_current_cell_is_header = (
                    tag == "th"
                )

                return

            if tag == "caption":

                self.finish_table_cell()

                self.table_current_cell = ""
                self.table_current_cell_is_header = False

                return

            if tag == "br":

                if self.table_current_cell is not None:

                    self.table_current_cell += "\n"

                return

            # Links innerhalb einer Tabelle
            if tag == "a":

                href = attrs.get(
                    "href",
                    ""
                )

                if href.startswith("/wiki/"):

                    title = href[
                        len("/wiki/"):
                    ]

                    title = urllib.parse.unquote(
                        title
                    )

                    title = title.replace(
                        "_",
                        " "
                    )

                    if ":" not in title:

                        self.current_link = {
                            "title": clean_text(title),
                            "text": ""
                        }

                return

            return

        # ----------------------------------------------------
        # Ignorierter Bereich
        # ----------------------------------------------------

        if self.skip_depth:

            self.skip_depth += 1
            return

        classes = attrs.get(
            "class",
            ""
        )

        element_id = attrs.get(
            "id",
            ""
        )

        class_list = classes.split()

        unwanted_classes = {
            "mw-editsection",
            "mw-editsection-bracket",
            "navbox",
            "vertical-navbox",
            "metadata",
            "ambox",
            "tmbox",
            "infobox",
            "sidebar",
            "reflist",
            "reference",
            "mw-references-wrap",
            "sisterproject",
            "hatnote",
            "plainlinks",
            "mw-jump",
            "catlinks",
            "portalbox",
            "noprint",
            "printonly",
            "thumbcaption",
            "shortdescription",
            "nomobile",
            "noexcerpt",
            "mw-cite-backlink"
        }

        # ----------------------------------------------------
        # Bearbeiten / Navigation / Infoboxen usw. entfernen
        # ----------------------------------------------------

        if (
            tag in self.skip_tags
            or element_id == "toc"
            or any(
                c in unwanted_classes
                for c in class_list
            )
        ):

            self.skip_depth = 1
            return

        # ----------------------------------------------------
        # Überschrift
        # ----------------------------------------------------

        if tag in {
            "h1",
            "h2",
            "h3",
            "h4",
            "h5",
            "h6"
        }:

            self.finish_line()

            level = int(tag[1])

            self.current = (
                "=" * (level + 3)
                + " "
            )

        # ----------------------------------------------------
        # Liste
        # ----------------------------------------------------

        elif tag == "li":

            self.finish_line()

            self.current = "- "

        # ----------------------------------------------------
        # Blockelement
        # ----------------------------------------------------

        elif tag in self.block_tags:

            self.finish_line()

        # ----------------------------------------------------
        # Wikipedia-Link
        # ----------------------------------------------------

        if tag == "a":

            href = attrs.get(
                "href",
                ""
            )

            if href.startswith("/wiki/"):

                title = href[
                    len("/wiki/"):
                ]

                title = urllib.parse.unquote(
                    title
                )

                title = title.replace(
                    "_",
                    " "
                )

                if ":" not in title:

                    self.current_link = {
                        "title": clean_text(title),
                        "text": ""
                    }

    # ========================================================
    # ENDTAG
    # ========================================================

    def handle_endtag(self, tag):

        # ----------------------------------------------------
        # Verschachtelte Tabelle
        # ----------------------------------------------------

        if self.table_depth > 1:

            if tag == "table":

                self.table_depth -= 1

            return

        # ----------------------------------------------------
        # Tabelle
        # ----------------------------------------------------

        if self.table_depth == 1:

            if tag in {"td", "th"}:

                self.finish_table_cell()
                return

            if tag == "tr":

                self.finish_table_row()
                return

            if tag == "caption":

                if self.table_current_cell is not None:

                    caption = clean_text(
                        self.table_current_cell
                    ).strip()

                    if caption:

                        self.table_caption = caption

                self.table_current_cell = None

                return

            if tag == "table":

                self.finish_table_row()

                rendered = render_table(
                    self.table_rows,
                    self.table_caption,
                    TEXT_WIDTH
                )

                self.lines.extend(
                    rendered
                )

                self.table_depth = 0
                self.table_rows = []
                self.table_current_row = None
                self.table_current_cell = None
                self.table_caption = None

                return

            # Link innerhalb einer Tabelle
            if (
                tag == "a"
                and self.current_link is not None
            ):

                visible_text = clean_text(
                    self.current_link["text"]
                ).strip()

                title = self.current_link[
                    "title"
                ]

                if visible_text:

                    if self.table_current_cell is not None:

                        self.table_current_cell += (
                            visible_text
                        )

                    self.register_link(
                        visible_text,
                        title
                    )

                self.current_link = None

                return

            return

        # ----------------------------------------------------
        # Ignorierter Bereich
        # ----------------------------------------------------

        if self.skip_depth:

            self.skip_depth -= 1
            return

        # ----------------------------------------------------
        # Normaler Wikipedia-Link
        # ----------------------------------------------------

        if (
            tag == "a"
            and self.current_link is not None
        ):

            visible_text = clean_text(
                self.current_link["text"]
            ).strip()

            title = self.current_link[
                "title"
            ]

            if visible_text:

                # Nur der sichtbare Text
                # kommt in die TXT.
                self.current += (
                    visible_text
                )

                self.register_link(
                    visible_text,
                    title
                )

            self.current_link = None

        # ----------------------------------------------------
        # Blockelement
        # ----------------------------------------------------

        if tag in self.block_tags:

            self.finish_line()

    # ========================================================
    # TEXT
    # ========================================================

    def handle_data(self, data):

        if self.skip_depth:
            return

        data = html.unescape(data)

        # Tabelle
        if self.table_depth == 1:

            if self.current_link is not None:

                self.current_link["text"] += data

            elif self.table_current_cell is not None:

                self.table_current_cell += data

            return

        # Normaler Text
        if self.current_link is not None:

            self.current_link["text"] += data

        else:

            self.current += data

    # ========================================================
    # LINK REGISTRIEREN
    # ========================================================

    def register_link(
        self,
        visible_text,
        title
    ):

        if not visible_text:
            return

        if not title:
            return

        if any(
            link["text"] == visible_text
            and link["title"] == title
            for link in self.links
        ):
            return

        self.links.append({
            "text": visible_text,
            "title": title,
            "url": (
                "https://de.wikipedia.org/wiki/"
                + urllib.parse.quote(
                    title.replace(
                        " ",
                        "_"
                    )
                )
            )
        })

    # ========================================================
    # TABELLENZELLE ABSCHLIESSEN
    # ========================================================

    def finish_table_cell(self):

        if self.table_current_cell is None:
            return

        value = clean_text(
            self.table_current_cell
        ).strip()

        if self.table_current_row is None:

            self.table_current_row = []

        self.table_current_row.append(
            value
        )

        self.table_current_cell = None

    # ========================================================
    # TABELLENZEILE ABSCHLIESSEN
    # ========================================================

    def finish_table_row(self):

        self.finish_table_cell()

        if (
            self.table_current_row
            and self.table_depth == 1
        ):

            # Eine Tabellenzeile gilt als Kopfzeile,
            # wenn mindestens eine Zelle ein <th> war.
            #
            # Für eine einfache Darstellung reicht hier
            # die Erkennung über die gespeicherte Information.
            #
            self.table_rows.append({
                "cells": self.table_current_row,
                "header": False
            })

        self.table_current_row = None

    # ========================================================
    # NORMALE ZEILE ABSCHLIESSEN
    # ========================================================

    def finish_line(self):

        text = clean_text(
            self.current
        ).strip()

        if text:

            self.lines.append(
                text
            )

        self.current = ""

    # ========================================================
    # TEXT AUSGEBEN
    # ========================================================

    def get_text(self):

        # Falls noch eine Tabelle offen ist
        if self.table_depth == 1:

            self.finish_table_row()

            rendered = render_table(
                self.table_rows,
                self.table_caption,
                TEXT_WIDTH
            )

            self.lines.extend(
                rendered
            )

            self.table_depth = 0

        self.finish_line()

        result = []
        empty_lines = 0

        for line in self.lines:

            if not line.strip():

                empty_lines += 1

                if empty_lines <= 2:

                    result.append("")

            else:

                empty_lines = 0
                result.append(line)

        return "\n".join(
            result
        ).strip()


# ============================================================
# WIKIPEDIA API
# ============================================================

def api_request(params):

    params["format"] = "json"
    params["formatversion"] = "2"

    url = (
        API_URL
        + "?"
        + urllib.parse.urlencode(params)
    )

    request = urllib.request.Request(
        url,
        headers={
            "User-Agent": USER_AGENT
        }
    )

    with urllib.request.urlopen(
        request
    ) as response:

        return json.loads(
            response.read().decode(
                "utf-8"
            )
        )


# ============================================================
# NANO-SYNTAXDATEI
# ============================================================

def create_nanorc(filepath, links):

    nanorc = filepath + ".nanorc"

    lines = []

    lines.append(
        'syntax "Wikipedia"'
    )

    # Überschriften
    lines.append(
        'color brightblue "^={3,}.*$"'
    )

    # Kopfzeilen
    lines.append(
        'color brightblue "^(ARTIKEL|ABGERUFEN|QUELLE):.*$"'
    )

    # Tabellenrahmen
    lines.append(
        'color cyan "^\\+[-+]+\\+$"'
    )

    lines.append(
        'color cyan "^\\|.*\\|$"'
    )

    # Linktexte grün
    seen = set()

    for link in links:

        link_text = link["text"].strip()

        if len(link_text) < 3:
            continue

        if link_text in seen:
            continue

        seen.add(
            link_text
        )

        pattern = re.escape(
            link_text
        )

        pattern = pattern.replace(
            r"\ ",
            " "
        )

        lines.append(
            f'color green "{pattern}"'
        )

    try:

        with open(
            nanorc,
            "w",
            encoding="utf-8"
        ) as file:

            file.write(
                "\n".join(lines)
                + "\n"
            )

    except Exception:

        return None

    return nanorc


# ============================================================
# SHELL-QUOTIERUNG
# ============================================================

def shlex_quote(text):

    return (
        "'"
        + text.replace(
            "'",
            "'\\''"
        )
        + "'"
    )


