)


# ============================================================
# TEXT BEREINIGEN
# ============================================================

def clean_text(text):

    replacements = {
        "\u00a0": " ",
        "\u2000": " ",
        "\u2001": " ",
        "\u2002": " ",
        "\u2003": " ",
        "\u2004": " ",
        "\u2005": " ",
        "\u2006": " ",
        "\u2007": " ",
        "\u2008": " ",
        "\u2009": " ",
        "\u200a": " ",
        "\u202f": " ",
        "\u205f": " ",
        "\u3000": " ",

        "\u200b": "",
        "\u200c": "",
        "\u200d": "",
        "\ufeff": "",
        "\u00ad": "",

        "\u2010": "-",
        "\u2011": "-",
        "\u2012": "-",
        "\u2013": "-",
        "\u2014": "-",
        "\u2212": "-",

        "\u2018": "'",
        "\u2019": "'",
        "\u201a": "'",
        "\u201b": "'",

        "\u201c": '"',
        "\u201d": '"',
        "\u201e": '"',
        "\u201f": '"',
    }

    for old, new in replacements.items():
        text = text.replace(old, new)

    # Steuerzeichen entfernen
    text = "".join(
        c for c in text
        if c in "\n\t" or ord(c) >= 32
    )

    # Tabs in Leerzeichen umwandeln
    text = text.replace("\t", " ")

    # Mehrfache Leerzeichen reduzieren
    text = re.sub(r" {2,}", " ", text)

    return text


# ============================================================
# TEXT AUF 78 ZEICHEN UMBRECHEN
# ============================================================

def wrap_text(text, width=78):

    result = []

    for line in text.splitlines():

        line = line.strip()

        if not line:
            result.append("")
            continue

        # Überschriften nicht umbrechen
        if line.startswith("="):
            result.append(line)
            continue

        # Listenpunkte
        if line.startswith("- "):

            wrapped = textwrap.wrap(
                line,
                width=width,
                subsequent_indent="  ",
                break_long_words=False,
                break_on_hyphens=False
            )

        else:

            wrapped = textwrap.wrap(
                line,
                width=width,
                break_long_words=False,
                break_on_hyphens=False
            )

        result.extend(wrapped)

    return "\n".join(result)


# ============================================================
# HTML -> TEXT
# ============================================================

class WikipediaParser(HTMLParser):

    def __init__(self):

        super().__init__(
            convert_charrefs=True
        )

        self.lines = []
        self.current = ""

        # Alle gefundenen internen Wikipedia-Links
        self.links = []

        # Aktuell geöffneter Link
        self.current_link = None

        # Bereich, der ignoriert wird
        self.skip_depth = 0

        self.block_tags = {
            "p",
            "div",
            "section",
            "h1",
            "h2",
            "h3",
            "h4",
            "h5",
            "h6",
            "li",
            "dd",
            "dt",
            "tr",
            "blockquote",
            "pre"
        }

        self.skip_tags = {
            "script",
            "style",
            "noscript",
            "svg",
            "math"
        }

    # --------------------------------------------------------
    # STARTTAG
    # --------------------------------------------------------

    def handle_starttag(self, tag, attrs):

        attrs = dict(attrs)

        # Bereits in einem zu ignorierenden Bereich
        if self.skip_depth:

            self.skip_depth += 1
            return

        classes = attrs.get(
            "class",
            ""
        )

        element_id = attrs.get(
            "id",
            ""
        )

        class_list = classes.split()

        # Diese Wikipedia-Webelemente gehören nicht in
        # unseren reinen Artikeltext.
        unwanted_classes = {
            "mw-editsection",
            "mw-editsection-bracket",
            "navbox",
            "vertical-navbox",
            "metadata",
            "ambox",
            "tmbox",
            "infobox",
            "sidebar",
            "reflist",
            "reference",
            "mw-references-wrap",
            "sisterproject",
            "hatnote",
            "plainlinks",
            "mw-jump",
            "catlinks",
            "portalbox",
            "noprint",
            "printonly",
            "thumbcaption"
        }

        if (
            tag in self.skip_tags
            or element_id == "toc"
            or any(
                c in unwanted_classes
                for c in class_list
            )
        ):

            self.skip_depth = 1
            return

        # ----------------------------------------------------
        # Überschriften
        # ----------------------------------------------------

        if tag in {
            "h1",
            "h2",
            "h3",
            "h4",
            "h5",
            "h6"
        }:

            self.finish_line()

            level = int(tag[1])

            self.current = (
                "=" * (level + 3)
                + " "
            )

        # ----------------------------------------------------
        # Listen
        # ----------------------------------------------------

        elif tag == "li":

            self.finish_line()

            self.current = "- "

        # ----------------------------------------------------
        # Absatz / Blockelement
        # ----------------------------------------------------

        elif tag in self.block_tags:

            self.finish_line()

        # ----------------------------------------------------
        # Wikipedia-Link
        # ----------------------------------------------------

        if tag == "a":

            href = attrs.get(
                "href",
                ""
            )

            if href.startswith("/wiki/"):

                title = href[
                    len("/wiki/"):
                ]

                title = urllib.parse.unquote(
                    title
                )

                title = title.replace(
                    "_",
                    " "
                )

                # Sonderseiten wie Kategorien, Dateien,
                # Hilfe usw. nicht als normale Links behandeln.
                if ":" not in title:

                    self.current_link = {
                        "title": clean_text(title),
                        "text": ""
                    }

    # --------------------------------------------------------
    # ENDTAG
    # --------------------------------------------------------

    def handle_endtag(self, tag):

        # Ignorierter Bereich
        if self.skip_depth:

            self.skip_depth -= 1
            return

        # ----------------------------------------------------
        # Wikipedia-Link abschließen
        # ----------------------------------------------------

        if (
            tag == "a"
            and self.current_link is not None
        ):

            visible_text = clean_text(
                self.current_link["text"]
            ).strip()

            title = self.current_link["title"]

            if visible_text:

                # Nur der sichtbare Text kommt in den Artikel.
                # Keine [[ ]] mehr.
                self.current += visible_text

                # Link für die Linkliste speichern
                if not any(
                    link["text"] == visible_text
                    and link["title"] == title
                    for link in self.links
                ):

                    self.links.append({
                        "text": visible_text,
                        "title": title,
                        "url": (
                            "https://de.wikipedia.org/wiki/"
                            + urllib.parse.quote(
                                title.replace(
                                    " ",
                                    "_"
                                )
                            )
                        )
                    })

            self.current_link = None

        # ----------------------------------------------------
        # Blockelement abschließen
        # ----------------------------------------------------

        if tag in self.block_tags:

            self.finish_line()

    # --------------------------------------------------------
    # TEXT
    # --------------------------------------------------------

    def handle_data(self, data):

        if self.skip_depth:
            return

        data = html.unescape(data)

        if self.current_link is not None:

            self.current_link["text"] += data

        else:

            self.current += data

    # --------------------------------------------------------
    # ZEILE ABSCHLIESSEN
    # --------------------------------------------------------

    def finish_line(self):

        text = clean_text(
            self.current
        ).strip()

        if text:

            self.lines.append(
                text
            )

        self.current = ""

    # --------------------------------------------------------
    # TEXT AUSGEBEN
    # --------------------------------------------------------

    def get_text(self):

        self.finish_line()

        result = []
        empty_lines = 0

        for line in self.lines:

            if not line.strip():

                empty_lines += 1

                if empty_lines <= 2:

                    result.append("")

            else:

                empty_lines = 0
                result.append(line)

        return "\n".join(
            result
        ).strip()


# ============================================================
# WIKIPEDIA API
# ============================================================

def api_request(params):

    params["format"] = "json"
    params["formatversion"] = "2"

    url = (
        API_URL
        + "?"
        + urllib.parse.urlencode(params)
    )

    request = urllib.request.Request(
        url,
        headers={
            "User-Agent": USER_AGENT
        }
    )

    with urllib.request.urlopen(
        request
    ) as response:

        return json.loads(
            response.read().decode(
                "utf-8"
            )
        )


# ============================================================
# NANO-SYNTAXDATEI
# ============================================================

def create_nanorc(filepath, links):

    nanorc = filepath + ".nanorc"

    lines = []

    lines.append(
        'syntax "Wikipedia"'
    )

    # Hauptüberschriften
    lines.append(
        'color brightblue "^={3,}.*$"'
    )

    # Kopfzeilen
    lines.append(
        'color brightblue "^(ARTIKEL|ABGERUFEN|QUELLE):.*$"'
    )

    # Linktexte grün hervorheben
    seen = set()

    for link in links:

        link_text = link["text"].strip()

        if len(link_text) < 3:
            continue

        if link_text in seen:
            continue

        seen.add(link_text)

        pattern = re.escape(
            link_text
        )

        pattern = pattern.replace(
            r"\ ",
            " "
        )

        lines.append(
            f'color green "{pattern}"'
        )

    try:

        with open(
            nanorc,
            "w",
            encoding="utf-8"
        ) as file:

            file.write(
                "\n".join(lines)
                + "\n"
            )

    except Exception:

        return None

    return nanorc


# ============================================================
# SHELL-QUOTIERUNG
# ============================================================

def shlex_quote(text):

    return (
        "'"
        + text.replace(
            "'",
            "'\\''"
        )
        + "'"
    )


# ============================================================
# ARTIKEL HERUNTERLADEN
# ============================================================

def download_article(title):

    print()
    print("Wikipedia")
    print("=" * 60)
    print()
    print(f"Suche: {title}")
    print()

    params = {
        "action": "parse",
        "page": title,
        "prop": "text",
        "redirects": "1"
    }

    try:

        data = api_request(
            params
        )

    except Exception as error:

        print()
        print(
            "Fehler beim Abrufen des Artikels:"
        )
        print(error)

        return 1

    # --------------------------------------------------------
    # Artikel nicht gefunden
    # --------------------------------------------------------

    if "error" in data:

        print()
        print(
            "Der Artikel wurde nicht gefunden."
        )
        print()

        search_params = {
            "action": "query",
            "list": "search",
            "srsearch": title,
            "srlimit": "5"
        }

        try:

            search = api_request(
                search_params
            )

            results = (
                search
                .get("query", {})
                .get("search", [])
            )

            if results:

                print(
                    "Vielleicht meinst du:"
                )
                print()

                for result in results:

                    print(
                        "  - "
                        + result["title"]
                    )

                print()

        except Exception:
            pass

        return 1

    parse = data.get(
        "parse"
    )

    if not parse:

        print(
            "Keine Daten erhalten."
        )

        return 1

    real_title = parse.get(
        "title",
        title
    )

    article_html = parse.get(
        "text",
        ""
    )

    # --------------------------------------------------------
    # HTML verarbeiten
    # --------------------------------------------------------

    parser = WikipediaParser()

    parser.feed(
        article_html
    )

    text = parser.get_text()

    # Fließtext auf 78 Zeichen umbrechen
    text = wrap_text(
        text,
        78
    )

    links = parser.links

    # --------------------------------------------------------
    # Dateiname
    # --------------------------------------------------------

    filename = clean_text(
        real_title
    )

    filename = re.sub(
        r'[\\/:*?"<>|]',
        "_",
        filename
    )

    filename = filename.replace(
        " ",
        "_"
    )

    filename += ".txt"

    output_dir = os.path.expanduser(
        "~/Dokumente/Wikipedia"
    )

    os.makedirs(
        output_dir,
        exist_ok=True
    )

    filepath = os.path.join(
        output_dir,
        filename
    )

    # --------------------------------------------------------
    # Datum und Quelle
    # --------------------------------------------------------

    now = datetime.now()

    source_url = (
        "https://de.wikipedia.org/wiki/"
        + urllib.parse.quote(
            real_title.replace(
                " ",
                "_"
            )
        )
    )

    # --------------------------------------------------------
    # Kopf
    # --------------------------------------------------------

    header = f"""================================================================
                         WIKIPEDIA
================================================================

ARTIKEL:
{real_title}

ABGERUFEN:
{now.strftime("%d.%m.%Y um %H:%M Uhr")}

QUELLE:
{source_url}

================================================================

"""

    # --------------------------------------------------------
    # Linkliste
    # --------------------------------------------------------

    link_section = """
================================================================
                    WEITERFÜHRENDE ARTIKEL
================================================================

"""

    if links:

        for number, link in enumerate(
            links,
            start=1
        ):

            link_section += (
                f"[{number:03d}] "
                f"{link['text']}\n"
                f"      Artikel: "
                f"{link['title']}\n"
                f"      {link['url']}\n\n"
            )

    else:

        link_section += (
            "Keine internen Wikipedia-Links gefunden.\n"
        )

    link_section += f"""
================================================================
                           HINWEIS
================================================================

Dieser Artikel wurde am
{now.strftime("%d.%m.%Y um %H:%M Uhr")}
aus der deutschsprachigen Wikipedia abgerufen.

Quelle:
https://de.wikipedia.org/

Die Wikipedia-Inhalte stehen unter freien Lizenzen.
Die jeweiligen Lizenzbedingungen sind zu beachten.

================================================================
"""

    # --------------------------------------------------------
    # Datei speichern
    # --------------------------------------------------------

    try:

        with open(
            filepath,
            "w",
            encoding="utf-8"
        ) as file:

            file.write(
                header
                + text
                + "\n"
                + link_section
            )

    except Exception as error:

        print()
        print(
            "Fehler beim Speichern:"
        )
        print(error)

        return 1

    # --------------------------------------------------------
    # Nano-Syntax erstellen
    # --------------------------------------------------------

    nanorc = create_nanorc(
        filepath,
        links
    )

    # --------------------------------------------------------
    # Ergebnis
    # --------------------------------------------------------

    print()
    print(
        "Artikel erfolgreich heruntergeladen."
    )
    print()
    print(
        f"Titel: {real_title}"
    )
    print(
        f"Datei: {filepath}"
    )
    print(
        f"Links: {len(links)}"
    )
    print()

    # --------------------------------------------------------
    # Nano starten
    # --------------------------------------------------------

    if nanorc:

        command = (
            "nano "
            "--rcfile="
            + shlex_quote(nanorc)
            + " "
            "--syntax=Wikipedia "
            + shlex_quote(filepath)
        )

        os.system(
            command
        )

    else:

        os.system(
            "nano "
            + shlex_quote(filepath)
        )

    return 0


# ============================================================
# HAUPTPROGRAMM
# ============================================================

def main():

    if len(sys.argv) < 3:

        print()
        print(
            "Verwendung:"
        )
        print()
        print(
            "  wikipedia download ARTIKEL"
        )
        print()

        return 1

    command = sys.argv[1].lower()

    if command != "download":

        print()
        print(
            "Unbekannter Befehl."
        )
        print()
        print(
            "Verwendung:"
        )
        print(
            "  wikipedia download ARTIKEL"
        )
        print()

        return 1

    title = " ".join(
        sys.argv[2:]
    ).strip()

    if not title:

        print(
            "Kein Artikel angegeben."
        )

        return 1

    return download_article(
        title
    )


# ============================================================
# START
# ============================================================

if __name__ == "__main__":

    sys.exit(
        main()
    )
