            start=1
        ):

            link_section += (
                f"[{number:03d}] "
                f"{link['text']}\n"
                f"      Artikel: "
                f"{link['title']}\n"
                f"      {link['url']}\n\n"
            )

    else:

        link_section += (
            "Keine internen Wikipedia-Links gefunden.\n"
        )

    link_section += f"""
================================================================
                           HINWEIS
================================================================

Dieser Artikel wurde am
{now.strftime("%d.%m.%Y um %H:%M Uhr")}
aus der deutschsprachigen Wikipedia abgerufen.

Quelle:
https://de.wikipedia.org/

Die Wikipedia-Inhalte stehen unter freien Lizenzen.
Die jeweiligen Lizenzbedingungen sind zu beachten.

================================================================
"""

    # --------------------------------------------------------
    # Datei schreiben
    # --------------------------------------------------------

    try:

        with open(
            filepath,
            "w",
            encoding="utf-8"
        ) as file:

            file.write(
                header
                + text
                + "\n"
                + link_section
            )

    except Exception as error:

        print()
        print(
            "Fehler beim Speichern:"
        )
        print(error)

        return 1

    # --------------------------------------------------------
    # Nano-Syntax erstellen
    # --------------------------------------------------------

    nanorc = create_nanorc(
        filepath,
        links
    )

    # --------------------------------------------------------
    # Ergebnis
    # --------------------------------------------------------

    print()
    print(
        "Artikel erfolgreich heruntergeladen."
    )
    print()

    print(
        f"Titel: {real_title}"
    )

    print(
        f"Datei: {filepath}"
    )

    print(
        f"Links: {len(links)}"
    )

    print()

    # --------------------------------------------------------
    # Nano starten
    # --------------------------------------------------------

    if nanorc:

        command = (
            "nano "
            "--rcfile="
            + shlex_quote(nanorc)
            + " "
            "--syntax=Wikipedia "
            + shlex_quote(filepath)
        )

        os.system(
            command
        )

    else:

        os.system(
            "nano "
            + shlex_quote(filepath)
        )

    return 0


