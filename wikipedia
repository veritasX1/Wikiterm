    print()

    params = {
        "action": "parse",
        "page": title,
        "prop": "text",
        "redirects": "1"
    }

    try:

        data = api_request(
            params
        )

    except Exception as error:

        print()
        print(
            "Fehler beim Abrufen des Artikels:"
        )
        print(error)

        return 1

